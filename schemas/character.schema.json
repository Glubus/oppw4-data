{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oppw4.tools/schemas/character.schema.json",
  "title": "OPPW4 Character",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "aliases", "ids", "models", "assets"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playable", "runtime", "boss_runtime", "model"],
      "properties": {
        "playable": {
          "$ref": "#/$defs/nullable_u16"
        },
        "runtime": {
          "$ref": "#/$defs/nullable_u16"
        },
        "boss_runtime": {
          "$ref": "#/$defs/nullable_u16"
        },
        "model": {
          "$ref": "#/$defs/nullable_u16"
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stem", "kind"],
        "properties": {
          "id": {
            "$ref": "#/$defs/nullable_u16"
          },
          "stem": {
            "type": ["string", "null"]
          },
          "kind": {
            "type": "string",
            "enum": ["primary", "costume", "form", "npc", "unknown"]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "model",
            "texture",
            "portrait",
            "ui",
            "material",
            "effect",
            "sound",
            "voice",
            "rdb",
            "linkdata",
            "unknown"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "type": ["string", "null"],
          "examples": ["CharacterEditor", "MaterialEditor", "ScreenLayout"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "hash": {
          "type": ["string", "null"],
          "pattern": "^0x[0-9a-fA-F]{8}$"
        },
        "file_type": {
          "type": ["string", "null"],
          "examples": ["g1m", "g1t", "g1a", "bin", "awb", "acb"]
        },
        "slot": {
          "$ref": "#/$defs/nullable_u16"
        },
        "model_id": {
          "$ref": "#/$defs/nullable_u16"
        },
        "source": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nullable_u16": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 65535
    }
  }
}
